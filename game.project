[project]
title = Decore Template
custom_resources = /resources
bundle_resources = /bundle
publisher = Insality Games
developer = Insality
platform_name = stub
dependencies#0 = https://github.com/subsoap/defos/archive/refs/tags/v2.7.1.zip
dependencies#1 = https://github.com/britzl/deftest/archive/refs/tags/2.8.0.zip
dependencies#2 = https://github.com/Insality/defold-log/archive/refs/heads/develop.zip
dependencies#3 = https://github.com/Insality/defold-event/archive/refs/heads/develop.zip
dependencies#4 = https://github.com/Insality/panthera/archive/refs/heads/develop.zip
dependencies#5 = https://github.com/Insality/druid/archive/refs/heads/develop.zip
dependencies#6 = https://github.com/Insality/defold-tweener/archive/refs/heads/develop.zip
dependencies#7 = https://github.com/Insality/defold-saver/archive/refs/heads/develop.zip
dependencies#8 = https://github.com/Insality/defold-lang/archive/refs/heads/develop.zip
dependencies#9 = https://github.com/Insality/decore/archive/refs/heads/develop.zip
dependencies#10 = https://github.com/Insality/detiled/archive/refs/heads/develop.zip
dependencies#11 = https://github.com/Insality/defold-token/archive/refs/heads/develop.zip
dependencies#12 = https://github.com/Insality/defold-quest/archive/refs/heads/main.zip

[bootstrap]
main_collection = /loader.collectionc
render = /builtins/render/default.renderc

[input]
game_binding = /builtins/input/all.input_bindingc
use_accelerometer = 0

[display]
width = 1920
height = 1080
high_dpi = 1

[osx]
localizations = en,ru

[android]
input_method = HiddenInputField
immersive_mode = 1

[script]
shared_state = 1

[model]
max_count = 0

[graphics]
max_draw_calls = 256

[native_extension]
app_manifest = /game/game.appmanifest

[render]
clear_color_red = 0.122
clear_color_green = 0.113
clear_color_blue = 0.172

[html5]
show_fullscreen_button = 0
show_made_with_defold = 0
show_console_banner = 0
heap_size = 128
scale_mode = stretch

[tilemap]
max_count = 0
max_tile_count = 0

[sprite]
max_count = 1024

[mesh]
max_count = 0

[saver]
autosave_timer = 2

[decore]
assistant_systems_path = /system/systems.lua
assistant_entities_path = /entity/entities.lua

[lang]
path = /resources/locales
langs = en
default = en

